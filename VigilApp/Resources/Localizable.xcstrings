    "Clique com o botão direito num pad para escolher um som de fábrica, ou importe o seu.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Right-click a pad to choose a factory sound, or import your own."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic derecho en un pad para elegir un sonido de fábrica, o importa el tuyo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites un clic droit sur un pad pour choisir un son d'usine, ou importez le vôtre."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique com o botão direito num pad para escolher um som de fábrica, ou importe o seu."
