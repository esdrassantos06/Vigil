    "Entradas, canal e MIDI Learn. No Mac, aparelhos Bluetooth entram pelo Audio MIDI Setup do sistema.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inputs, channel and MIDI Learn. On Mac, Bluetooth devices are paired in the system's Audio MIDI Setup."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entradas, canal y MIDI Learn. En Mac, los dispositivos Bluetooth se emparejan en Configuración de Audio MIDI del sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrées, canal et MIDI Learn. Sur Mac, les appareils Bluetooth se jumellent dans Configuration audio et MIDI du système."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entradas, canal e MIDI Learn. No Mac, aparelhos Bluetooth entram pelo Audio MIDI Setup do sistema."
          }
        }
      }
    },
